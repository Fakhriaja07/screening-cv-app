# Contoh konfigurasi backend Analisis AI.
# Untuk uji lokal: salin file ini menjadi .env.local lalu isi nilainya.
# Untuk produksi: pasang variabel yang sama di Vercel
# (Project → Settings → Environment Variables), lalu redeploy.
# JANGAN pernah meng-commit API key asli ke Git.

OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it
