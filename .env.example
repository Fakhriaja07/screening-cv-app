# Contoh konfigurasi backend Analisis AI.
# Untuk uji lokal: salin file ini menjadi .env.local lalu isi nilainya.
# Untuk produksi: pasang variabel yang sama di Vercel
# (Project → Settings → Environment Variables), lalu redeploy.
# JANGAN pernah meng-commit API key asli ke Git.

OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Pembayaran otomatis Midtrans (opsional — tanpa variabel ini, paywall
# QRIS manual tetap menjadi jalur aktif dan /api/payment-config
# menjawab mode "off").
# Ambil dari dashboard Midtrans: Settings → Access Keys
# (pisahkan kunci Sandbox dan Production; kunci Sandbox berawalan
# "SB-"). MIDTRANS_IS_PRODUCTION hanya diisi "true" bila memakai
# kunci Production; selain itu mode dianggap Sandbox.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
